# Azure / Entra ID app registration
AZURE_CLIENT_ID=
# Use "consumers" for personal MS account, "organizations" for work, or tenant GUID
AZURE_TENANT_ID=consumers

# OneNote target (sections worden per ISO-week automatisch aangemaakt)
NOTEBOOK_NAME=Plaud Notes

# Lokale transcript-dump (markdown per opname, gegroepeerd per week)
# Zet TRANSCRIPTS=off om uit te zetten.
# TRANSCRIPTS_DIR=/Users/jouw-naam/Documents/PlaudTranscripts

# Audio-download (nu onderdeel van `npm run sync`; ook los aan te roepen
# via `npm run audio:download`). Zet AUDIO=off om audio uit sync te halen.
# AUDIO=off
# AUDIO_DIR=/Users/jouw-naam/Documents/PlaudAudio
# AUDIO_FORMAT=mp3   # of "opus" voor kleinere files

# Kennisbank (npm run kb:enrich / kb:index). Standaard naast TRANSCRIPTS_DIR: <map>/Kennisbank
# KB_DIR=/Users/jouw-naam/Documents/Kennisbank
# Lokaal taalmodel via Ollama. Transcripten bevatten klantgegevens en gaan alleen naar een lokaal model.
# KB_MODEL=gemma3:12b
# KB_CONTEXT=16384
# KB_CHUNK_CHARS=16000
# KB_TIMEZONE=Europe/Amsterdam
# Na de dagelijkse sync ook de kennisbank bijwerken:
# KB_AUTO=on
